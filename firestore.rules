rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pair(x, y) { return x < y ? x + '_' + y : y + '_' + x; }
    // True if `owner` has accepted you as a friend and switched on "Share my training"
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function validLib(d) {
      return d.by == me() && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.muscle is string && d.muscle.size() <= 20 && d.equip is string && d.equip.size() <= 20
        && d.byName is string && d.byName.size() <= 60;
    }
    function sharesWith(owner) {
      let path = /databases/$(database)/documents/links/$(pair(owner, me()));
      return exists(path) && get(path).data.status == 'accepted' && get(path).data.share[owner] == true;
    }

    // Your own data: only you can change it; friends you share with can read it
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
      allow read: if signedIn() && sharesWith(uid);
    }

    // Friend codes: anyone signed in can look up a code, only its owner can claim or change it
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Admins (create the doc admins/<your user id> by hand in the console). You can only check yourself.
    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
    }

    // Shared exercise database: everyone signed in can read; you can add, edit and remove your own;
    // admins can remove anything
    match /library/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validLib(request.resource.data);
      allow update: if signedIn() && resource.data.by == me() && validLib(request.resource.data);
      allow delete: if signedIn() && (resource.data.by == me() || isAdmin());
    }

    // Friend links between two people (id = the two user ids, sorted, joined by _)
    match /links/{id} {
      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.status == 'pending'
        && id == pair(request.resource.data.members[0], request.resource.data.members[1]);
      // Each person may only change their own share switch and name; only the invited person can accept
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'share', 'names', 'u'])
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending' && request.resource.data.status == 'accepted' && me() != resource.data.from))
        && request.resource.data.share.diff(resource.data.share).affectedKeys().hasOnly([me()])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()]);
      allow delete: if signedIn() && me() in resource.data.members;
    }
  }
}
